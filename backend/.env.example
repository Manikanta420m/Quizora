# ==============================================================================
# AI Quiz Generator - Backend Environment Configuration Example
# Copy this file to .env and configure your values.
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=development

# Persistence (Optional - will fallback automatically to in-memory store if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_quiz_generator
REDIS_URL=redis://127.0.0.1:6379

# Client URL (CORS origin)
CLIENT_URL=http://localhost:3000

# Authentication Secrets (Generate secure 64+ char random keys for production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_me_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me_in_production

# AI API Key (Optional - supports Google Gemini API Key or OpenAI API Key)
# If omitted or offline, the procedural heuristic AI engine will automatically serve quizzes & hints.
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
