{
  "name": "Quizora",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack AI Quiz Generator Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "npm test --prefix backend && npm test --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "quiz",
    "ai",
    "nextjs",
    "express",
    "pure-javascript",
    "gamification",
    "mongodb",
    "redis"
  ],
  "license": "MIT"
}
